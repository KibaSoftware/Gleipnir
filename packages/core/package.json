{
  "name": "@gleip/core",
  "version": "0.5.0",
  "description": "Shared domain primitives for Gleip.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./findings": {
      "types": "./findings.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "findings.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
