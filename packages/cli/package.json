{
  "name": "gleip",
  "version": "1.2.0",
  "description": "Passive-first local evidence ledger and precision risk observer for coding-agent work.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/KibaSoftware/Gleipnir.git"
  },
  "homepage": "https://github.com/KibaSoftware/Gleipnir#readme",
  "bugs": {
    "url": "https://github.com/KibaSoftware/Gleipnir/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gleip": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ai",
    "ai-agent",
    "coding-agent",
    "coding-agents",
    "agentic-coding",
    "agent-guardrails",
    "llm-tools",
    "vibe-coding",
    "code-quality",
    "code-review",
    "static-analysis",
    "repo-guardrails",
    "cli",
    "developer-tools",
    "local-only"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.mjs",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "yaml": "^2.0.0",
    "zod": "^3.0.0"
  }
}
