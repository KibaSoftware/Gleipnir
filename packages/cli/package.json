{
  "name": "gleip",
  "version": "0.3.0",
  "description": "Local-only guardrails that AI coding agents use automatically.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/KibaSoftware/Gleipnir.git"
  },
  "homepage": "https://github.com/KibaSoftware/Gleipnir#readme",
  "bugs": {
    "url": "https://github.com/KibaSoftware/Gleipnir/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gleip": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ai",
    "coding-agents",
    "code-review",
    "cli",
    "agent-guardrails",
    "developer-tools",
    "local-only"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "yaml": "^2.0.0",
    "zod": "^3.0.0"
  }
}
