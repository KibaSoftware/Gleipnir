{
  "name": "gleip",
  "version": "0.5.0",
  "description": "Local-only guardrails that AI coding agents use automatically.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/KibaSoftware/Gleipnir.git"
  },
  "homepage": "https://github.com/KibaSoftware/Gleipnir#readme",
  "bugs": {
    "url": "https://github.com/KibaSoftware/Gleipnir/issues"
  },
  "type": "module",
  "main": "./packages/cli/dist/index.js",
  "module": "./packages/cli/dist/index.js",
  "types": "./packages/cli/dist/index.d.ts",
  "bin": {
    "gleip": "./packages/cli/dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./packages/cli/dist/index.d.ts",
      "import": "./packages/cli/dist/index.js"
    }
  },
  "files": [
    "packages/cli/dist",
    "packages/cli/package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "ai",
    "ai-agent",
    "coding-agent",
    "coding-agents",
    "agentic-coding",
    "agent-guardrails",
    "llm-tools",
    "vibe-coding",
    "code-quality",
    "code-review",
    "static-analysis",
    "repo-guardrails",
    "cli",
    "developer-tools",
    "local-only"
  ],
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "gleip": "tsx packages/cli/src/index.ts",
    "build": "pnpm -r build",
    "clean": "node scripts/clean.mjs",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "pack:cli": "node scripts/pack-cli.mjs",
    "smoke:cli": "node scripts/smoke-cli.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "commander": "^12.0.0",
    "yaml": "^2.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
