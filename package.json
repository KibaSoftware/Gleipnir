{
  "name": "gleip",
  "version": "0.2.2",
  "private": true,
  "description": "A control layer for AI coding agents that keeps generated code lean, scoped, tested, and merge-ready.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "gleip": "tsx packages/cli/src/index.ts",
    "build": "pnpm -r build",
    "clean": "node scripts/clean.mjs",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "pack:cli": "node scripts/pack-cli.mjs",
    "smoke:cli": "node scripts/smoke-cli.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
